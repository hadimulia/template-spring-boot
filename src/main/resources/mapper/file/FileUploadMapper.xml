<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.template.mapper.file.FileUploadMapper">

    <resultMap id="responseMap" type="com.template.dto.file.FileUploadResponse">
        <id property="id" column="id"/>
        <result property="originalName" column="original_name"/>
        <result property="contentType" column="content_type"/>
        <result property="fileSize" column="file_size"/>
        <result property="entityType" column="entity_type"/>
        <result property="entityId" column="entity_id"/>
        <result property="createdBy" column="created_by"/>
        <result property="createdDate" column="created_date"/>
    </resultMap>

    <select id="findByEntity" resultMap="responseMap">
        SELECT id, original_name, content_type, file_size, entity_type, entity_id, created_by, created_date
        FROM file_uploads
        WHERE entity_type = #{entityType} AND entity_id = #{entityId}
        ORDER BY created_date DESC
    </select>

    <select id="findAll" resultMap="responseMap">
        SELECT id, original_name, content_type, file_size, entity_type, entity_id, created_by, created_date
        FROM file_uploads
        ORDER BY created_date DESC
    </select>

</mapper>
