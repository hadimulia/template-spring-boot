<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.template.registry.mapper.SchoolUserMapper">

    <resultMap id="schoolUserMap" type="com.template.entity.registry.SchoolUser">
        <id property="id" column="id"/>
        <result property="schoolId" column="school_id"/>
        <result property="userId" column="user_id"/>
        <result property="username" column="username"/>
        <result property="enabled" column="enabled"/>
        <result property="createdBy" column="created_by"/>
        <result property="createdDate" column="created_date"/>
        <result property="updatedBy" column="updated_by"/>
        <result property="updatedDate" column="updated_date"/>
        <result property="deleted" column="deleted"/>
    </resultMap>

    <select id="findByUsername" resultMap="schoolUserMap">
        SELECT * FROM school_users WHERE username = #{username} AND deleted = false
    </select>

    <select id="findByUserIdAndSchool" resultMap="schoolUserMap">
        SELECT * FROM school_users WHERE user_id = #{userId} AND school_id = #{schoolId} AND deleted = false
    </select>

    <select id="findBySchoolAndUsername" resultMap="schoolUserMap">
        SELECT * FROM school_users
        WHERE school_id = #{schoolId} AND username = #{username} AND deleted = false
    </select>

</mapper>
